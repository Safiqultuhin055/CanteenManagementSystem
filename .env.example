DB_NAME=CanteenManagementDB
DB_USER=
DB_PASSWORD=
DB_HOST=(localdb)\MSSQLLocalDB
DB_PORT=
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated IPs/hostnames for LAN TVs and other PCs (e.g. 192.168.1.50)
ALLOWED_HOSTS=127.0.0.1,localhost,192.168.120.51,192.168.153.248
# IIS / browser CSRF (include scheme): http://localhost,http://192.168.120.51
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost,http://192.168.120.51,http://192.168.153.248
STATIC_URL=/static/
MEDIA_URL=/media/
# IIS application alias (e.g. Default Web Site -> cms): /cms
FORCE_SCRIPT_NAME=/cms
