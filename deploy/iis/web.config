<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS site physical path = project root (folder containing manage.py).
  Edit processPath and PYTHONPATH below before first use.
  Requires: IIS + HttpPlatformHandler (install via Web Platform Installer or Server Manager).
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*"
           modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform
      processPath="C:\Path\To\venv\Scripts\python.exe"
      arguments="&quot;E:\Python Project\CanteenManagementSystem\deploy\iis\run_iis.py&quot;"
      stdoutLogEnabled="true"
      stdoutLogFile=".\logs\iis_stdout"
      startupTimeLimit="120"
      processesPerApplication="1">
      <environmentVariables>
        <environmentVariable name="DJANGO_SETTINGS_MODULE" value="canteen_system.settings" />
        <environmentVariable name="PYTHONPATH" value="E:\Python Project\CanteenManagementSystem" />
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
      </environmentVariables>
    </httpPlatform>
    <security>
      <requestFiltering allowDoubleEscaping="true" />
    </security>
  </system.webServer>

  <!-- Optional: serve collected static files directly from IIS (faster than Django) -->
  <location path="static">
    <system.webServer>
      <handlers>
        <clear />
        <add name="StaticFile" path="*" verb="*" modules="StaticFileModule"
             resourceType="Either" requireAccess="Read" />
      </handlers>
    </system.webServer>
  </location>

  <!-- Menu / upload images -->
  <location path="media">
    <system.webServer>
      <handlers>
        <clear />
        <add name="StaticFile" path="*" verb="*" modules="StaticFileModule"
             resourceType="Either" requireAccess="Read" />
      </handlers>
    </system.webServer>
  </location>
</configuration>
