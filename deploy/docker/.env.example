# Docker CMS — copy to deploy/docker/.env or let docker-start.ps1 generate it.
CMS_PORT=365

DB_NAME=CanteenManagementDB
DB_USER=sa
DB_PASSWORD=@Mis#Dev
DB_HOST=192.168.153.248
DB_PORT=1433
DB_DRIVER=ODBC Driver 18 for SQL Server

DEBUG=False
SECRET_KEY=cms-docker-lan-change-in-production
ALLOWED_HOSTS=127.0.0.1,localhost,192.168.120.51,192.168.153.248
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:365,http://localhost:365,http://192.168.120.51:365,http://192.168.153.248:365
FORCE_SCRIPT_NAME=

# POS voice assistant — keys are normally managed in the app
# (admin -> API integrations). These are only a fallback when the
# api_integrations table has no active row. Leave blank to rely on DB.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
