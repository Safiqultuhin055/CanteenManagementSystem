# Shared SQL Server — use for BOTH local dev (runserver) and Docker (LAN).
# Copy to .env on each PC:  copy .env.shared.example .env
# Only one environment should run at a time (local OR Docker server), same DB data.

DB_NAME=CanteenManagementDB
DB_USER=sa
DB_PASSWORD=@Mis#Dev
DB_HOST=192.168.153.248
DB_PORT=1433
DB_DRIVER=ODBC Driver 17 for SQL Server

DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string

# Local dev
ALLOWED_HOSTS=127.0.0.1,localhost,192.168.120.51,192.168.153.248
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://192.168.120.51:365,http://192.168.153.248:365

STATIC_URL=/static/
MEDIA_URL=/media/
FORCE_SCRIPT_NAME=

# POS voice assistant — fallback only; prefer DB (admin → API integrations).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
